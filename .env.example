# Copia este archivo a .env.local y completa con los valores de tu proyecto
# Supabase (Settings -> API en el dashboard). Sin estas variables, la app
# sigue funcionando en modo local/demo (ver README).

VITE_SUPABASE_URL=
# publishable key (o la anon legacy). Nunca la secret/service_role.
VITE_SUPABASE_ANON_KEY=

# Opcional, solo para aplicar migraciones desde scripts locales (NUNCA con
# prefijo VITE_ ni en Vercel): cadena del pooler (Connect → Transaction/Session
# pooler) con la contraseña de la base.
SUPABASE_DB_URL=
